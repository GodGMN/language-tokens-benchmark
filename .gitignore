# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Node
**/node_modules/
npm-debug.log*

# Build output (any language, anywhere)
**/target/
**/*.o
**/*.out
**/__pycache__/

# Compiled `workflow` binaries (path-specific so the JS shell launcher stays tracked)
submissions/**/go/workflow
submissions/**/c/workflow
submissions/**/rust/workflow
submissions/**/bin/workflow

# Results: keep the derived artifacts, ignore raw session dumps
results/**/*.jsonl
results/**/raw/
results/**/*.log


# Editor / OS
.vscode/
.idea/
.DS_Store

# Task binaries
submissions/**/go/expr
submissions/**/c/expr
submissions/**/rust/expr
submissions/**/go/patch
submissions/**/c/patch
submissions/**/rust/patch
