{
  "version": 1,
  "steps": [
    { "id": "obj", "op": "constant",
      "args": { "value": { "b": 2, "a": { "z": 1 }, "c": 3 } } },
    { "id": "keys", "op": "keys", "depends_on": ["obj"],
      "args": { "input": { "$ref": "obj" } } },
    { "id": "values", "op": "values", "depends_on": ["obj"],
      "args": { "input": { "$ref": "obj" } } },
    { "id": "got", "op": "get", "depends_on": ["obj"],
      "args": { "input": { "$ref": "obj" }, "key": "b" } },
    { "id": "missing", "op": "get", "depends_on": ["obj"],
      "args": { "input": { "$ref": "obj" }, "key": "nope" } },
    { "id": "added", "op": "set", "depends_on": ["obj"],
      "args": { "input": { "$ref": "obj" }, "key": "d", "value": [1, 2] } },
    { "id": "merged", "op": "merge",
      "args": { "a": { "x": 1, "y": 2 }, "b": { "y": 20, "z": 30 } } },
    { "id": "picked", "op": "pick", "depends_on": ["obj"],
      "args": { "input": { "$ref": "obj" }, "keys": ["c", "a", "missing"] } },
    { "id": "omitted", "op": "omit", "depends_on": ["obj"],
      "args": { "input": { "$ref": "obj" }, "keys": ["b"] } }
  ]
}
