{
  "version": 1,
  "steps": [
    { "id": "n", "op": "range", "args": { "start": 1, "end": 6 } },
    { "id": "evens", "op": "filter", "depends_on": ["n"],
      "args": { "input": { "$ref": "n" }, "predicate": { "type": "even" } } },
    { "id": "scaled", "op": "map", "depends_on": ["evens"],
      "args": { "input": { "$ref": "evens" }, "transform": { "type": "multiply", "value": 3 } } },
    { "id": "total", "op": "sum", "depends_on": ["scaled"],
      "args": { "input": { "$ref": "scaled" } } },
    { "id": "minus", "op": "subtract", "depends_on": ["total"],
      "args": { "a": { "$ref": "total" }, "b": 1 } },
    { "id": "quotient", "op": "divide", "args": { "a": -7, "b": 2 } },
    { "id": "remainder", "op": "mod", "args": { "a": -7, "b": 2 } }
  ]
}
