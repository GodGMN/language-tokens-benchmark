{
  "version": 1,
  "steps": [
    { "id": "input", "op": "constant", "args": { "value": [3, 1, 2, 1, 3] } },
    { "id": "sorted", "op": "sort", "depends_on": ["input"],
      "args": { "input": { "$ref": "input" } } },
    { "id": "unique", "op": "unique", "depends_on": ["input"],
      "args": { "input": { "$ref": "input" } } },
    { "id": "reversed", "op": "reverse", "depends_on": ["sorted"],
      "args": { "input": { "$ref": "sorted" } } },
    { "id": "sliced", "op": "slice", "depends_on": ["input"],
      "args": { "input": { "$ref": "input" }, "start": 1, "end": 4 } },
    { "id": "flat", "op": "flatten",
      "args": { "input": [1, [2, 3], [], 4] } },
    { "id": "reduced", "op": "reduce", "depends_on": ["input"],
      "args": { "input": { "$ref": "input" }, "op": "add", "initial": 10 } },
    { "id": "mix", "op": "constant",
      "args": { "value": [{ "b": 1, "a": 2 }, [2], null, true, "z", 3, false, "a", [1, 2], [1]] } },
    { "id": "mixed_sorted", "op": "sort", "depends_on": ["mix"],
      "args": { "input": { "$ref": "mix" } } }
  ]
}
