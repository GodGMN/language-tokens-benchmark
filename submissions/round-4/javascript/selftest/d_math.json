{
  "version": 1,
  "steps": [
    { "id": "nums", "op": "range", "args": { "start": 1, "end": 6 } },
    { "id": "total", "op": "sum", "depends_on": ["nums"], "args": { "input": { "$ref": "nums" } } },
    { "id": "lo", "op": "min", "depends_on": ["nums"], "args": { "input": { "$ref": "nums" } } },
    { "id": "hi", "op": "max", "depends_on": ["nums"], "args": { "input": { "$ref": "nums" } } },
    { "id": "avgish", "op": "divide", "depends_on": ["total"], "args": { "a": { "$ref": "total" }, "b": 4 } },
    { "id": "rem", "op": "mod", "depends_on": ["total"], "args": { "a": { "$ref": "total" }, "b": 4 } },
    { "id": "diff", "op": "subtract", "depends_on": ["hi", "lo"], "args": { "a": { "$ref": "hi" }, "b": { "$ref": "lo" } } },
    { "id": "prod", "op": "multiply", "depends_on": ["diff"], "args": { "a": { "$ref": "diff" }, "b": 6 } },
    { "id": "plus", "op": "add", "depends_on": ["prod"], "args": { "a": { "$ref": "prod" }, "b": -10 } }
  ]
}
