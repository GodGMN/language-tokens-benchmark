{
  "version": 1,
  "steps": [
    { "id": "raw", "op": "constant",
      "args": { "value": [3, 1, 2, 1, "b", "a", true, false, null] } },
    { "id": "sorted", "op": "sort", "depends_on": ["raw"],
      "args": { "input": { "$ref": "raw" } } },
    { "id": "reversed", "op": "reverse", "depends_on": ["sorted"],
      "args": { "input": { "$ref": "sorted" } } },
    { "id": "uniq", "op": "unique", "depends_on": ["raw"],
      "args": { "input": { "$ref": "raw" } } },
    { "id": "head", "op": "slice", "depends_on": ["sorted"],
      "args": { "input": { "$ref": "sorted" }, "start": 0, "end": -2 } },
    { "id": "tail", "op": "slice", "depends_on": ["sorted"],
      "args": { "input": { "$ref": "sorted" }, "start": -3 } },
    { "id": "flat", "op": "flatten", "depends_on": ["raw"],
      "args": { "input": [1, [2, 3], [[4]], 5] } },
    { "id": "mapped", "op": "map", "depends_on": ["raw"],
      "args": { "input": [1, -2, 3], "transform": { "type": "op", "op": "subtract",
        "args": { "a": { "$self": true }, "b": 10 } } } },
    { "id": "types", "op": "map", "depends_on": ["raw"],
      "args": { "input": { "$ref": "raw" }, "transform": { "type": "type" } } }
  ]
}
