{
  "version": 1,
  "steps": [
    { "id": "nums", "op": "range", "args": { "start": 1, "end": 10 } },
    { "id": "evens", "op": "filter", "depends_on": ["nums"],
      "args": { "input": { "$ref": "nums" }, "predicate": { "type": "even" } } },
    { "id": "doubled", "op": "map", "depends_on": ["evens"],
      "args": { "input": { "$ref": "evens" }, "transform": { "type": "multiply", "value": 2 } } },
    { "id": "total", "op": "sum", "depends_on": ["doubled"],
      "args": { "input": { "$ref": "doubled" } } },
    { "id": "difference", "op": "subtract", "depends_on": ["total"],
      "args": { "a": { "$ref": "total" }, "b": 7 } },
    { "id": "product", "op": "reduce", "depends_on": ["evens"],
      "args": { "input": { "$ref": "evens" }, "op": "multiply", "initial": 1 } },
    { "id": "lowest", "op": "min", "depends_on": ["evens"],
      "args": { "input": { "$ref": "evens" } } },
    { "id": "highest", "op": "max", "depends_on": ["evens"],
      "args": { "input": { "$ref": "evens" } } },
    { "id": "divided", "op": "divide", "depends_on": ["difference"],
      "args": { "a": { "$ref": "difference" }, "b": -2 } },
    { "id": "rem", "op": "mod", "depends_on": ["difference"],
      "args": { "a": { "$ref": "difference" }, "b": 4 } }
  ]
}
