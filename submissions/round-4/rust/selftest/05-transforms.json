{
  "version": 1,
  "steps": [
    { "id": "n", "op": "range", "args": { "start": 1, "end": 5 } },
    { "id": "add10", "op": "map", "depends_on": ["n"],
      "args": { "input": { "$ref": "n" }, "transform": { "type": "add", "value": 10 } } },
    { "id": "neg", "op": "map", "depends_on": ["n"],
      "args": { "input": { "$ref": "n" }, "transform": { "type": "negate" } } },
    { "id": "absmap", "op": "map",
      "args": { "input": [-3, 4], "transform": { "type": "abs" } } },
    { "id": "strmap", "op": "map", "depends_on": ["n"],
      "args": { "input": { "$ref": "n" }, "transform": { "type": "stringify" } } },
    { "id": "types", "op": "map",
      "args": { "input": [null, true, 1, "a", [], {}], "transform": { "type": "type" } } },
    { "id": "opadd", "op": "map", "depends_on": ["n"],
      "args": { "input": { "$ref": "n" },
        "transform": { "type": "op", "op": "add", "args": { "a": { "$self": true }, "b": 100 } } } },
    { "id": "constmap", "op": "map", "depends_on": ["n"],
      "args": { "input": { "$ref": "n" }, "transform": { "type": "constant", "value": "x" } } },
    { "id": "evens", "op": "filter", "depends_on": ["n"],
      "args": { "input": { "$ref": "n" }, "predicate": { "type": "even" } } },
    { "id": "odds", "op": "filter", "depends_on": ["n"],
      "args": { "input": { "$ref": "n" }, "predicate": { "type": "odd" } } },
    { "id": "truthy", "op": "filter",
      "args": { "input": [0, 1, "", "x", null, false, true, [], [1], {}, { "a": 1 }],
                "predicate": { "type": "truthy" } } },
    { "id": "contains", "op": "filter",
      "args": { "input": ["abc", "xyz", "b"], "predicate": { "type": "string_contains", "value": "b" } } },
    { "id": "type_is", "op": "filter",
      "args": { "input": [1, "a", null, true, [], {}], "predicate": { "type": "type_is", "value": "string" } } }
  ]
}
