{
  "version": 1,
  "steps": [
    { "id": "obj", "op": "constant", "args": { "value": { "b": 2, "a": 1, "c": 3 } } },
    { "id": "ks", "op": "keys", "depends_on": ["obj"], "args": { "input": { "$ref": "obj" } } },
    { "id": "vs", "op": "values", "depends_on": ["obj"], "args": { "input": { "$ref": "obj" } } },
    { "id": "with_d", "op": "set", "depends_on": ["obj"],
      "args": { "input": { "$ref": "obj" }, "key": "d", "value": 4 } },
    { "id": "missing", "op": "get", "depends_on": ["obj"],
      "args": { "input": { "$ref": "obj" }, "key": "zz" } },
    { "id": "merged", "op": "merge", "depends_on": ["obj"],
      "args": { "a": { "$ref": "obj" }, "b": { "b": 20, "e": 5 } } },
    { "id": "picked", "op": "pick", "depends_on": ["obj"],
      "args": { "input": { "$ref": "obj" }, "keys": ["c", "a", "zz"] } },
    { "id": "omitted", "op": "omit", "depends_on": ["obj"],
      "args": { "input": { "$ref": "obj" }, "keys": ["b"] } },
    { "id": "got", "op": "get", "depends_on": ["obj"],
      "args": { "input": { "$ref": "obj" }, "key": "a" } }
  ]
}
