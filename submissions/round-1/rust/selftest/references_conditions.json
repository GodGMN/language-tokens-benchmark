{
  "version": 1,
  "steps": [
    { "id": "data", "op": "constant",
      "args": { "value": { "user": { "name": "Ana", "age": 30 }, "items": [10, 20, 30] } } },
    { "id": "name", "op": "constant", "depends_on": ["data"],
      "args": { "value": { "$ref": "data.user.name" } } },
    { "id": "age", "op": "constant", "depends_on": ["data"],
      "args": { "value": { "$ref": "data.user.age" } } },
    { "id": "first_item", "op": "constant", "depends_on": ["data"],
      "args": { "value": { "$ref": "data.items.0" } } },
    { "id": "adult", "op": "constant", "depends_on": ["age"],
      "args": { "value": "adult" },
      "when": { "op": "gte", "left": { "$ref": "age" }, "right": 18 } },
    { "id": "child", "op": "constant", "depends_on": ["age"],
      "args": { "value": "child" },
      "when": { "op": "lt", "left": { "$ref": "age" }, "right": 18 } },
    { "id": "greeting", "op": "concat", "depends_on": ["name"],
      "args": { "a": "Hello, ", "b": { "$ref": "name" } } },
    { "id": "is_ana", "op": "equals", "depends_on": ["name"],
      "args": { "a": { "$ref": "name" }, "b": "Ana" } }
  ]
}
