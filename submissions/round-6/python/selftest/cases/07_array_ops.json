{
  "version": 1,
  "steps": [
    { "id": "nums", "op": "constant", "args": { "value": [5, 3, 5, 1, 3, 2] } },
    { "id": "sorted", "op": "sort", "depends_on": ["nums"],
      "args": { "input": {"$ref": "nums"} } },
    { "id": "reversed", "op": "reverse", "depends_on": ["nums"],
      "args": { "input": {"$ref": "nums"} } },
    { "id": "uniq", "op": "unique", "depends_on": ["nums"],
      "args": { "input": {"$ref": "nums"} } },
    { "id": "sliced", "op": "slice", "depends_on": ["nums"],
      "args": { "input": {"$ref": "nums"}, "start": 1, "end": -1 } },
    { "id": "nested", "op": "constant", "args": { "value": [[1, 2], [3], [], 4] } },
    { "id": "flat", "op": "flatten", "depends_on": ["nested"],
      "args": { "input": {"$ref": "nested"} } },
    { "id": "mapped", "op": "map", "depends_on": ["nums"],
      "args": { "input": {"$ref": "nums"}, "transform": { "type": "add", "value": 10 } } },
    { "id": "kept", "op": "filter", "depends_on": ["nums"],
      "args": { "input": {"$ref": "nums"}, "predicate": { "type": "gt", "value": 2 } } },
    { "id": "product", "op": "reduce", "depends_on": ["nums"],
      "args": { "input": {"$ref": "nums"}, "op": "multiply" } },
    { "id": "sub_init", "op": "reduce", "depends_on": ["nums"],
      "args": { "input": {"$ref": "nums"}, "op": "subtract", "initial": 100 } },
    { "id": "mixed", "op": "sort",
      "args": { "input": ["b", 2, true, null, [1], { "a": 1 }, 1, "a"] } }
  ]
}
