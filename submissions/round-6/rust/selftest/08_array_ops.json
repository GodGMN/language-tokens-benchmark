{
  "version": 1,
  "steps": [
    { "id": "src", "op": "constant", "args": { "value": [5, 3, 5, 1, 2, 1] } },
    { "id": "sorted", "op": "sort", "depends_on": ["src"],
      "args": { "input": { "$ref": "src" } } },
    { "id": "uniq", "op": "unique", "depends_on": ["src"],
      "args": { "input": { "$ref": "src" } } },
    { "id": "rev", "op": "reverse", "depends_on": ["uniq"],
      "args": { "input": { "$ref": "uniq" } } },
    { "id": "sliced", "op": "slice", "depends_on": ["rev"],
      "args": { "input": { "$ref": "rev" }, "start": 1, "end": 3 } },
    { "id": "flat", "op": "flatten", "depends_on": ["src"],
      "args": { "input": [[1, 2], [3], [], [4, [5]]] } },
    { "id": "mapped", "op": "map", "depends_on": ["src"],
      "args": { "input": { "$ref": "src" }, "transform": { "type": "subtract", "value": 1 } } },
    { "id": "filtered", "op": "filter", "depends_on": ["mapped"],
      "args": { "input": { "$ref": "mapped" }, "predicate": { "type": "gt", "value": 0 } } },
    { "id": "reduced", "op": "reduce", "depends_on": ["filtered"],
      "args": { "input": { "$ref": "filtered" }, "op": "add" } },
    { "id": "total_sliced", "op": "sum", "depends_on": ["sliced"],
      "args": { "input": { "$ref": "sliced" } } }
  ]
}
