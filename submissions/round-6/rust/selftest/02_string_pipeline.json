{
  "version": 1,
  "steps": [
    { "id": "raw", "op": "constant", "args": { "value": "  Hello, World!  " } },
    { "id": "trimmed", "op": "trim", "depends_on": ["raw"],
      "args": { "input": { "$ref": "raw" } } },
    { "id": "upper", "op": "uppercase", "depends_on": ["trimmed"],
      "args": { "input": { "$ref": "trimmed" } } },
    { "id": "lower", "op": "lowercase", "depends_on": ["upper"],
      "args": { "input": { "$ref": "upper" } } },
    { "id": "spaced", "op": "replace", "depends_on": ["lower"],
      "args": { "input": { "$ref": "lower" }, "search": " ", "replace": "_" } },
    { "id": "parts", "op": "split", "depends_on": ["spaced"],
      "args": { "input": { "$ref": "spaced" }, "sep": "," } },
    { "id": "joined", "op": "join", "depends_on": ["parts"],
      "args": { "input": { "$ref": "parts" }, "sep": "|" } },
    { "id": "len", "op": "length", "depends_on": ["joined"],
      "args": { "input": { "$ref": "joined" } } }
  ]
}
