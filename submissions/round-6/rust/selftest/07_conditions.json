{
  "version": 1,
  "steps": [
    { "id": "a", "op": "constant", "args": { "value": 5 } },
    { "id": "b", "op": "constant", "args": { "value": "gte" },
      "depends_on": ["a"],
      "when": { "op": "all", "conditions": [
        { "op": "gte", "left": { "$ref": "a" }, "right": 5 },
        { "op": "ne", "left": "x", "right": "y" }
      ] } },
    { "id": "c", "op": "constant", "args": { "value": "no" },
      "depends_on": ["b"],
      "when": { "op": "any", "conditions": [
        { "op": "lt", "left": { "$ref": "a" }, "right": 0 },
        { "op": "eq", "left": { "$ref": "a" }, "right": 6 }
      ] } },
    { "id": "d", "op": "constant", "args": { "value": "not" },
      "depends_on": ["c"],
      "when": { "op": "not", "condition": { "op": "lt", "left": { "$ref": "a" }, "right": 5 } } }
  ]
}
