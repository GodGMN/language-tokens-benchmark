{
  "version": 1,
  "steps": [
    { "id": "nums", "op": "range", "args": { "start": 1, "end": 10 } },
    { "id": "doubled", "op": "map", "depends_on": ["nums"],
      "args": { "input": {"$ref": "nums"}, "transform": { "type": "multiply", "value": 2 } } },
    { "id": "big", "op": "filter", "depends_on": ["doubled"],
      "args": { "input": {"$ref": "doubled"}, "predicate": { "type": "gt", "value": 10 } } },
    { "id": "total", "op": "reduce", "depends_on": ["big"],
      "args": { "input": {"$ref": "big"}, "op": "add" } },
    { "id": "sorted", "op": "sort", "depends_on": ["doubled"],
      "args": { "input": {"$ref": "doubled"} } },
    { "id": "reversed", "op": "reverse", "depends_on": ["sorted"],
      "args": { "input": {"$ref": "sorted"} } },
    { "id": "uniq", "op": "unique", "depends_on": ["nums"],
      "args": { "input": [3, 1, 3, 2, 1] } },
    { "id": "flat", "op": "flatten", "depends_on": ["nums"],
      "args": { "input": [1, [2, 3], [[4]], 5] } }
  ]
}
