{
  "version": 1,
  "steps": [
    { "id": "nums", "op": "constant", "args": { "value": [5, 1, 3, 1, 4, 2] } },
    { "id": "doubled", "op": "map", "depends_on": ["nums"],
      "args": { "input": { "$ref": "nums" }, "transform": { "type": "multiply", "value": 2 } } },
    { "id": "big", "op": "filter", "depends_on": ["nums"],
      "args": { "input": { "$ref": "nums" }, "predicate": { "type": "gte", "value": 3 } } },
    { "id": "product", "op": "reduce", "depends_on": ["nums"],
      "args": { "input": { "$ref": "nums" }, "op": "multiply" } },
    { "id": "ordered", "op": "sort", "depends_on": ["nums"], "args": { "input": { "$ref": "nums" } } },
    { "id": "backwards", "op": "reverse", "depends_on": ["nums"], "args": { "input": { "$ref": "nums" } } },
    { "id": "distinct", "op": "unique", "depends_on": ["nums"], "args": { "input": { "$ref": "nums" } } },
    { "id": "middle", "op": "slice", "depends_on": ["nums"],
      "args": { "input": { "$ref": "nums" }, "start": 1, "end": -1 } },
    { "id": "flat", "op": "flatten", "args": { "input": [1, [2, 3], [], [[4]]] } },
    { "id": "mixed", "op": "sort", "args": { "input": [true, "b", null, 2, "a", false] } }
  ]
}
