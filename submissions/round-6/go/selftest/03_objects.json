{
  "version": 1,
  "steps": [
    {"id": "base", "op": "constant", "args": {"value": {"b": 2, "a": 1}}},
    {"id": "withC", "op": "set", "depends_on": ["base"],
     "args": {"input": {"$ref": "base"}, "key": "c", "value": [true, null]}},
    {"id": "got", "op": "get", "depends_on": ["withC"], "args": {"input": {"$ref": "withC"}, "key": "c"}},
    {"id": "missing", "op": "get", "depends_on": ["base"], "args": {"input": {"$ref": "base"}, "key": "zz"}},
    {"id": "ks", "op": "keys", "depends_on": ["withC"], "args": {"input": {"$ref": "withC"}}},
    {"id": "vs", "op": "values", "depends_on": ["withC"], "args": {"input": {"$ref": "withC"}}},
    {"id": "merged", "op": "merge", "depends_on": ["base"],
     "args": {"a": {"$ref": "base"}, "b": {"a": 9, "d": 4}}},
    {"id": "picked", "op": "pick", "depends_on": ["merged"],
     "args": {"input": {"$ref": "merged"}, "keys": ["a", "zz"]}},
    {"id": "omitted", "op": "omit", "depends_on": ["merged"],
     "args": {"input": {"$ref": "merged"}, "keys": ["b", "zz"]}}
  ]
}
