{
  "version": 1,
  "steps": [
    { "id": "vals", "op": "constant", "args": { "value": [3, 1, 2, 1, 3] } },
    { "id": "sorted", "op": "sort", "depends_on": ["vals"],
      "args": { "input": { "$ref": "vals" } } },
    { "id": "uniq", "op": "unique", "depends_on": ["vals"],
      "args": { "input": { "$ref": "vals" } } },
    { "id": "rev", "op": "reverse", "depends_on": ["vals"],
      "args": { "input": { "$ref": "vals" } } },
    { "id": "sliced", "op": "slice", "depends_on": ["vals"],
      "args": { "input": { "$ref": "vals" }, "start": 1, "end": 4 } },
    { "id": "nested", "op": "constant", "args": { "value": [[1, 2], 3, [4]] } },
    { "id": "flat", "op": "flatten", "depends_on": ["nested"],
      "args": { "input": { "$ref": "nested" } } },
    { "id": "reduced", "op": "reduce", "depends_on": ["vals"],
      "args": { "input": { "$ref": "vals" }, "op": "multiply" } }
  ]
}
