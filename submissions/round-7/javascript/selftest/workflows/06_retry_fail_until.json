{
  "version": 1,
  "steps": [
    { "id": "flaky", "op": "fail_until",
      "args": { "failures": 2, "value": "ok" },
      "retry": { "max_attempts": 3 } },
    { "id": "instant", "op": "fail_until",
      "args": { "failures": 0, "value": { "nested": [1, 2] } } },
    { "id": "after", "op": "concat", "depends_on": ["flaky"],
      "args": { "a": { "$ref": "flaky" }, "b": "!" } }
  ]
}
