{
  "version": 1,
  "steps": [
    { "id": "nums", "op": "range", "args": { "start": 1, "end": 10 } },
    { "id": "total", "op": "sum", "depends_on": ["nums"],
      "args": { "input": { "$ref": "nums" } } },
    { "id": "doubled", "op": "multiply", "depends_on": ["total"],
      "args": { "a": { "$ref": "total" }, "b": 2 } },
    { "id": "minus", "op": "subtract", "depends_on": ["doubled"],
      "args": { "a": { "$ref": "doubled" }, "b": 10 } },
    { "id": "quot", "op": "divide", "depends_on": ["minus"],
      "args": { "a": { "$ref": "minus" }, "b": 4 } },
    { "id": "rem", "op": "mod", "depends_on": ["quot"],
      "args": { "a": { "$ref": "quot" }, "b": 7 } },
    { "id": "lo", "op": "min", "depends_on": ["nums"], "args": { "input": { "$ref": "nums" } } },
    { "id": "hi", "op": "max", "depends_on": ["nums"], "args": { "input": { "$ref": "nums" } } }
  ]
}
