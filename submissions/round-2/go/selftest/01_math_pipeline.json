{
  "version": 1,
  "steps": [
    {"id": "n", "op": "range", "args": {"start": 1, "end": 5}},
    {"id": "evens", "op": "filter", "depends_on": ["n"],
     "args": {"input": {"$ref": "n"}, "predicate": {"type": "even"}}},
    {"id": "total", "op": "sum", "depends_on": ["evens"],
     "args": {"input": {"$ref": "evens"}}},
    {"id": "product", "op": "reduce", "depends_on": ["evens"],
     "args": {"input": {"$ref": "evens"}, "op": "multiply"}},
    {"id": "lo", "op": "min", "args": {"input": [-3, 7, 0]}},
    {"id": "hi", "op": "max", "args": {"input": [-3, 7, 0]}},
    {"id": "q", "op": "divide", "args": {"a": -7, "b": 2}},
    {"id": "r", "op": "mod", "args": {"a": -7, "b": 2}}
  ]
}
