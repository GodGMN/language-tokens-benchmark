{
  "version": 1,
  "steps": [
    {"id": "nums", "op": "range", "args": {"start": -2, "end": 4}},
    {"id": "doubled", "op": "map", "depends_on": ["nums"],
     "args": {"input": {"$ref": "nums"}, "transform": {"type": "multiply", "value": 2}}},
    {"id": "sorted", "op": "sort", "args": {"input": [3, "b", true, null, [2], {"a": 1}, false, 2, 1]}},
    {"id": "uniq", "op": "unique", "args": {"input": [1, 1.0, "1", 1, null, null, [1], [1]]}},
    {"id": "rev", "op": "reverse", "args": {"input": [1, 2, 3]}},
    {"id": "cut", "op": "slice", "args": {"input": [0, 1, 2, 3, 4], "start": -3, "end": -1}},
    {"id": "flat", "op": "flatten", "args": {"input": [1, [2, [3]], 4]}},
    {"id": "abs", "op": "map", "args": {"input": [-5, 5], "transform": {"type": "abs"}}},
    {"id": "fmt", "op": "map", "args": {"input": [1, "x", true], "transform": {"type": "stringify"}}},
    {"id": "kinds", "op": "map", "args": {"input": [null, true, 1, "x", [], {}], "transform": {"type": "type"}}}
  ]
}
