{
  "version": 1,
  "steps": [
    { "id": "data", "op": "constant",
      "args": { "value": { "user": { "name": "ada" }, "items": [10, 20, 30] } } },
    { "id": "name", "op": "uppercase", "depends_on": ["data"],
      "args": { "input": { "$ref": "data.user.name" } } },
    { "id": "third", "op": "add", "depends_on": ["data"],
      "args": { "a": { "$ref": "data.items.2" }, "b": { "$ref": "data.items.0" } } },
    { "id": "bundle", "op": "constant", "depends_on": ["name", "third"],
      "args": { "value": { "who": { "$ref": "name" }, "n": { "$ref": "third" } } } }
  ]
}
