{
  "version": 1,
  "steps": [
    { "id": "nums", "op": "range", "args": { "start": 1, "end": 10 } },
    { "id": "evens", "op": "filter", "depends_on": ["nums"],
      "args": { "input": {"$ref": "nums"}, "predicate": {"type": "even"} } },
    { "id": "total", "op": "sum", "depends_on": ["evens"],
      "args": { "input": {"$ref": "evens"} } },
    { "id": "scaled", "op": "multiply", "depends_on": ["total"],
      "args": { "a": {"$ref": "total"}, "b": 3 } },
    { "id": "quot", "op": "divide", "depends_on": ["scaled"],
      "args": { "a": {"$ref": "scaled"}, "b": -4 } },
    { "id": "rem", "op": "mod", "depends_on": ["scaled"],
      "args": { "a": {"$ref": "scaled"}, "b": -4 } },
    { "id": "lo", "op": "min", "depends_on": ["nums"],
      "args": { "input": {"$ref": "nums"} } },
    { "id": "hi", "op": "max", "depends_on": ["nums"],
      "args": { "input": {"$ref": "nums"} } }
  ]
}
