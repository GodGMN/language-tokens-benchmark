#!/usr/bin/env python3
"""Executable wrapper around workflow.py (optional convenience entry point)."""

import os
import sys

# Avoid writing __pycache__: the engine must not cause filesystem side effects.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import workflow  # noqa: E402

if __name__ == "__main__":
    sys.setrecursionlimit(20000)
    sys.exit(workflow.main(sys.argv))
