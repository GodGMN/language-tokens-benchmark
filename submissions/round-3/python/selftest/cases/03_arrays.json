{
  "version": 1,
  "steps": [
    { "id": "nums", "op": "constant", "args": { "value": [3, 1, 2, 1, 3] } },
    { "id": "ordered", "op": "sort", "args": { "input": {"$ref": "nums"} }, "depends_on": ["nums"] },
    { "id": "rev", "op": "reverse", "args": { "input": {"$ref": "nums"} }, "depends_on": ["nums"] },
    { "id": "uniq", "op": "unique", "args": { "input": {"$ref": "nums"} }, "depends_on": ["nums"] },
    { "id": "mapped", "op": "map", "depends_on": ["nums"],
      "args": { "input": {"$ref": "nums"}, "transform": {"type": "add", "value": 10} } },
    { "id": "mapop", "op": "map", "depends_on": ["nums"],
      "args": { "input": {"$ref": "nums"},
                "transform": {"type": "op", "op": "multiply",
                              "args": {"a": {"$self": true}, "b": 2}} } },
    { "id": "evens", "op": "filter", "depends_on": ["nums"],
      "args": { "input": {"$ref": "nums"}, "predicate": {"type": "even"} } },
    { "id": "big", "op": "filter", "depends_on": ["nums"],
      "args": { "input": {"$ref": "nums"}, "predicate": {"type": "gt", "value": 1} } },
    { "id": "five", "op": "constant", "args": { "value": [0, 1, 2, 3, 4] } },
    { "id": "sliced", "op": "slice", "depends_on": ["five"],
      "args": { "input": {"$ref": "five"}, "start": 1, "end": 4 } },
    { "id": "neg", "op": "slice", "depends_on": ["five"],
      "args": { "input": {"$ref": "five"}, "start": -2 } },
    { "id": "flat", "op": "flatten", "args": { "input": [1, [2, 3], [], 4] } },
    { "id": "mixed", "op": "sort",
      "args": { "input": [true, "b", null, 1, [1], {"a": 1}, "a", false] } },
    { "id": "types", "op": "map",
      "args": { "input": [1, "a", null, true], "transform": {"type": "type"} } },
    { "id": "stringified", "op": "map",
      "args": { "input": [1, "a", true, null], "transform": {"type": "stringify"} } }
  ]
}
