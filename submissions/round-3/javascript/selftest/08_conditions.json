{
  "version": 1,
  "steps": [
    { "id": "x", "op": "constant", "args": { "value": 10 } },
    { "id": "y", "op": "constant", "args": { "value": "big" },
      "depends_on": ["x"],
      "when": { "op": "all", "conditions": [
        { "op": "gt", "left": { "$ref": "x" }, "right": 5 },
        { "op": "not", "condition": { "op": "eq", "left": { "$ref": "x" }, "right": 7 } }
      ] } },
    { "id": "z", "op": "constant", "args": { "value": "never" },
      "depends_on": ["y"],
      "when": { "op": "any", "conditions": [
        { "op": "lt", "left": { "$ref": "x" }, "right": 0 },
        { "op": "eq", "left": { "$ref": "x" }, "right": 1 }
      ] } },
    { "id": "w", "op": "constant", "args": { "value": "again" },
      "depends_on": ["x"],
      "when": { "op": "eq", "left": { "$ref": "x" }, "right": 10 } }
  ]
}
