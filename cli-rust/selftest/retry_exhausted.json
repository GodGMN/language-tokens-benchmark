{
  "version": 1,
  "steps": [
    { "id": "first", "op": "constant", "args": { "value": 1 } },
    { "id": "flaky", "op": "fail_until",
      "args": { "failures": 2, "value": "never" },
      "depends_on": ["first"],
      "retry": { "max_attempts": 2 } },
    { "id": "after", "op": "constant", "args": { "value": 3 }, "depends_on": ["flaky"] }
  ]
}
