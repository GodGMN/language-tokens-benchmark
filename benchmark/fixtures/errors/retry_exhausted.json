{
  "name": "retry_exhausted",
  "input": {
    "version": 1,
    "steps": [
      { "id": "setup", "op": "constant", "args": { "value": 1 } },
      { "id": "flaky", "op": "fail_until", "args": { "failures": 2, "value": "ok" }, "depends_on": ["setup"], "retry": { "max_attempts": 2 } }
    ]
  },
  "expected_exit_code": 1,
  "expected_error_code": "STEP_FAILED",
  "expected_output": { "status": "failed", "results": { "setup": 1 }, "execution_order": ["setup"], "skipped": [], "error": { "code": "STEP_FAILED", "step": "flaky", "message": "attempts exhausted" } }
}
